# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
# Direct Postgres URL. docker compose overrides this to point at its own db.
# For a bare `uvicorn` run against the compose Postgres, uncomment:
# DATABASE_URL=postgresql+psycopg2://balancer:balancer@localhost:5432/balancer
